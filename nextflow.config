process.shell = '/bin/bash'

conda.enabled = true

profiles { 
    docker {
        docker.enabled          = true
        conda.enabled           = false
        docker.runOptions       = '-u $(id -u):$(id -g)'

        process {
            withName: merge {container = "pipecraft/pandaseq:2.11"}
            withName: pangolin {container = "staphb/pangolin:latest"}
            withName: nextclade {container = "nextstrain/nextclade:latest"}
            withName: summary {container = "ufuomababatunde/bammix:v1.1.0"}
            withName: bammix {container = "ufuomababatunde/bammix:v1.1.0"}
            withName: positions {container = "ufuomababatunde/bammix:v1.1.0"}
            withName: bammix_process {container = "ufuomababatunde/bammix:v1.1.0"}
            withName: flagged_positions {container = "ufuomababatunde/bammix:v1.1.0"}
            withName: flagged_samples {container = "ufuomababatunde/bammix:v1.1.0"}
            withName: makevcf {container = "staphb/bcftools:latest"}
            withName: bcftools {container = "staphb/bcftools:latest"}
            withName: virstrain_process {container = "lanadelrea/virstrain:v0.3.0"}
            withName: wrangling {container = "ufuomababatunde/bammix:v1.1.0"}
            withName: variants {container = "staphb/freyja:latest"}
            withName: demix {container = "staphb/freyja:latest"}
            withName: aggregate {container = "staphb/freyja:latest"}
            withName: plot_summarized {container = "staphb/freyja:latest"}
            withName: plot_lineage {container = "staphb/freyja:latest"}
            withName: list_lineages {container = "ufuomababatunde/bammix:v1.1.0"}
            withName: get_lineage_def {container = "staphb/freyja:latest"}
            withName: mutations {container = "ufuomababatunde/bammix:v1.1.0"}
            withName: get_pos_mut {container = "ufuomababatunde/bammix:v1.1.0"}
            withName: ampliconsorting {container = "maelanade/jvarkit:1.0"}
            withName: consensus {container = "maelanade/consensus:1.0"}
            withName: renamefasta {container = "nanozoo/seqkit:latest"}
            withName: bammixplot {container = "ufuomababatunde/bammix:v1.1.0"}
            withName: aafplots {container = "ufuomababatunde/bammix:v1.1.0"}
            withName: generation {container = "ufuomababatunde/rmarkdown:1.1.0"}
        }
    }
	  conda {
	      process.conda = [
          enabled = true]
        docker.enabled = false

        process {
            withName: merge {conda = "${projectDir}/envs/pandaseq.yml"}
            withName: pangolin {conda = "${projectDir}/envs/pangolin.yml"}
            withName: nextclade {conda = "${projectDir}/envs/nextclade.yml"}
            withName: summary {conda = "${projectDir}/envs/bammix.yml"}
            withName: bammix {conda = "${projectDir}/envs/bammix.yml"}
            withName: positions {conda = "${projectDir}/envs/bammix.yml"}
            withName: bammix_process {conda = "${projectDir}/envs/bammix.yml"}
            withName: flagged_positions {conda = "${projectDir}/envs/bammix.yml"}
            withName: flagged_samples {conda = "${projectDir}/envs/bammix.yml"}
            withName: makevcf {conda = "${projectDir}/envs/samtools_bcftools.yml"}
            withName: bcftools {conda = "${projectDir}/envs/samtools_bcftools.yml"}
            withName: virstrain_process {conda = "${projectDir}/envs/virstrain.yml"}
            withName: wrangling {conda = "${projectDir}/envs/bammix.yml"}
            withName: variants {conda = "${projectDir}/envs/freyja.yml"}
            withName: demix {conda = "${projectDir}/envs/freyja.yml"}
            withName: aggregate {conda = "${projectDir}/envs/freyja.yml"}
            withName: plot_summarized {conda = "${projectDir}/envs/freyja.yml"}
            withName: plot_lineage {conda = "${projectDir}/envs/freyja.yml"}
            withName: list_lineages {conda = "${projectDir}/envs/bammix.yml"}
            withName: get_lineage_def {conda = "${projectDir}/envs/freyja.yml"}
            withName: mutations {conda = "${projectDir}/envs/bammix.yml"}
            withName: get_pos_mut {conda = "${projectDir}/envs/bammix.yml"}
            withName: ampliconsorting {conda = "${projectDir}/envs/jvarkit.yml"}
            withName: consensus {conda = "${projectDir}/envs/consensus.yml"}
            withName: renamefasta {conda = "${projectDir}/envs/seqkit.yml"}
            withName: bammixplot {conda = "${projectDir}/envs/bammix.yml"}
            withName: aafplots {conda = "${projectDir}/envs/bammix.yml"}
            withName: generation {conda = "${projectDir}/envs/rmarkdown.yml"}
       }
    }
}

params {
  reference = "${projectDir}/assets/sars-cov-2/reference-sequence.fasta"
  GISAID_reference = "${projectDir}/assets/sars-cov-2/GISAID_reference.fasta"
  SC2_dataset = "${projectDir}/assets/sars-cov-2"
  primer_scheme = "${projectDir}/assets/primer-schemes/nCoV-2019/V4.1/SARS-CoV-2.scheme.bed"

  bammix_thresh = 0.8
  virstrain_database = "${projectDir}/assets/Custom_DB"

  annot="${projectDir}/assets/freyja-data/NC_045512_Hu-1.gff"
  ref="${projectDir}/assets/freyja-data/NC_045512_Hu-1.fasta"

  mutations_table = "${projectDir}/assets/mutations.tsv"

  jvarkit_jar = "${projectDir}/bin/jvarkit.jar"
  sort_reads = "${projectDir}/bin/sort_reads.java"
  
  sort_delta_reads = "${projectDir}/bin/sort_delta_reads.js"
  sort_omicron_reads = "${projectDir}/bin/sort_omicron_reads.js"

  report_r = "${projectDir}/bin/summary-report.R"
  report_rmd = "${projectDir}/bin/summary-report.Rmd"
  report_rmd_no_bammix = "${projectDir}/bin/summary-report-no-bammix.Rmd"

  help = false
}

process {
  withName: 'demix' {
    memory = '8 GB'
    cpus = 2
  }
  withName: 'ampliconsorting' {
    memory = '8 GB'
    cpus = 2
  }
}